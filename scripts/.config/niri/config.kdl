// Optimized niri config for laptops
// Focused on battery efficiency, touchpad gestures, and modern aesthetics

input {
    keyboard {
        xkb {
            // Your keyboard layout here
        }
        numlock
        // Add repeat settings for better typing experience
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        tap
        dwt  // Disable while typing - essential for laptops
        dwtp // Disable while trackpointing
        natural-scroll
        accel-speed 0.3  // Slightly faster for laptop touchpads
        accel-profile "adaptive"  // Better for precise touchpad control
        scroll-method "two-finger"
        disabled-on-external-mouse  // Save battery when mouse connected
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    // Enable focus-follows-mouse for efficiency
    focus-follows-mouse max-scroll-amount="10%"

    // Optional: warp mouse to new windows for faster navigation
    // warp-mouse-to-focus
}

// Laptop display configuration
output "eDP-1" {
    // Adjust mode based on your laptop screen
    // mode "1920x1080@60"

    // Scale for comfortable viewing on smaller screens
    scale 1.0

    // Variable refresh rate for battery savings
    variable-refresh-rate
}

layout {
    // Smaller gaps for laptop screens to maximize space
    gaps 8

    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Modern focus ring with gradient
    focus-ring {
        width 3

        // Sleek blue gradient
        active-gradient from="#7fc8ff" to="#5aa3e0" angle=135
        inactive-gradient from="#404040" to="#606060" angle=135 relative-to="workspace-view"
    }

    // Subtle border for visual clarity
    border {
        off
        // Uncomment for always-visible borders
        // width 2
        // active-color "#7fc8ff"
        // inactive-color "#404040"
        // urgent-color "#ff6b6b"
    }

    // Elegant shadows for depth
    shadow {
        on
        draw-behind-window true

        // Optimized shadow settings for performance
        softness 20
        spread 3
        offset x=0 y=3
        color "#00000040"  // 25% opacity for subtlety
    }

    struts {
        // Reserve space for status bars if needed
        // top 32
    }
}

// Launch essential services
spawn-at-startup "dms"

// Laptop power management
spawn-at-startup "wlsunset"  // Auto night light
spawn-sh-at-startup "swayidle -w timeout 300 'swaylock -f' timeout 600 'niri msg action power-off-monitors' before-sleep 'swaylock -f'"

hotkey-overlay {
    skip-at-startup  // Less intrusive on laptop
}

prefer-no-csd  // Maximize screen space, better for laptops

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Smooth but efficient animations
    // Disable completely for maximum battery: off

    // Slightly faster animations for snappier feel
    slowdown 0.8

    // Optimize specific animations
    workspace-switch {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 100
        curve "ease-out-quad"
    }

    window-resize {
        duration-ms 0  // Instant for better performance
    }
}

// Optimized window rules
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Rounded corners for modern look
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Make notification windows floating
window-rule {
    match app-id=r#"^(mako|dunst)$"#
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Essential laptop binds
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+E hotkey-overlay-title="File Manager" { spawn "nautilus"; }

    // Laptop-specific media controls
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }

    // Brightness controls - smaller increments for better control
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Keyboard backlight (if available)
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--device=*kbd_backlight" "set" "+10%"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--device=*kbd_backlight" "set" "10%-"; }

    // Overview for quick workspace navigation
    Mod+O repeat=false { toggle-overview; }
    // Three-finger swipe up also triggers overview

    Mod+Q repeat=false { close-window; }

    // Navigation - both arrow keys and vim keys
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Moving windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // Workspace navigation with smooth scrolling
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Mouse wheel workspace switching (laptop-friendly)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Touchpad gestures for workspaces
    Mod+TouchpadScrollDown { focus-workspace-down; }
    Mod+TouchpadScrollUp   { focus-workspace-up; }

    // Quick workspace access
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // Window management
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    // Fine adjustments
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Floating windows
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Screenshots
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Screen recording (add grim/slurp/wf-recorder)
    Mod+Print { spawn-sh "wf-recorder -f ~/Videos/$(date +%Y-%m-%d_%H-%M-%S).mp4"; }

    // Power management
    Mod+Shift+P { power-off-monitors; }

    // Quick lock (laptop-friendly)
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+q { quit; }

}

include "dms/cursor.kdl"
